{
    "name": "estamey/advent_of_code",
    "description": "Emily's Advent of Code Exercises",
    "type": "project",
    "license": ["proprietary"],
    "require": {
        "symfony/console": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.4",
        "phpstan/phpstan": "^2.1.33",
        "vimeo/psalm": "^6.5.0"
    },
    "autoload": {
        "psr-4": {"Acme\\": "src/"}
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "phpstan analyse",
        "psalm": "vendor/bin/psalm",
        "psalm-info": "vendor/bin/psalm --show-info=true"
    },
    "config": {
        "platform": {
            "php": "8.3"
        }
    }
}
